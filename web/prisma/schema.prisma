generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id                 String              @id @default(cuid())
  name               String
  slug               String              @unique
  status             WorkspaceStatus     @default(ACTIVE)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  clients            Client[]
  commercialActions  CommercialAction[]
  commercialEvents   CommercialEvent[]
  commercialJourneys CommercialJourney[]
  consortiums        Consortium[]
  consultants        Consultant[]
  journeyPhases      JourneyPhase[]
  journeyStates      JourneyState[]
  leads              Lead[]
  meetings           Meeting[]
  nextBestActions    NextBestAction[]
  pipelineStages     PipelineStage[]
  proposals          Proposal[]
  sales              Sale[]
  tasks              Task[]
  workflowRules      WorkflowRule[]

  @@index([status])
  @@map("workspaces")
}

model Consultant {
  id                 String              @id @default(cuid())
  workspaceId        String              @map("workspace_id")
  name               String
  email              String
  phone              String
  document           String
  role               ConsultantRole      @default(CONSULTANT)
  team               String
  region             String
  avatarUrl          String?             @map("avatar_url")
  status             ConsultantStatus    @default(ACTIVE)
  monthlySalesTarget Decimal             @default(0) @map("monthly_sales_target") @db.Decimal(18, 2)
  monthlyLeadsTarget Int                 @default(0) @map("monthly_leads_target")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  clients            Client[]
  commercialJourneys CommercialJourney[]
  workspace          Workspace           @relation(fields: [workspaceId], references: [id])
  leads              Lead[]
  meetings           Meeting[]
  proposals          Proposal[]
  sales              Sale[]
  assignedTasks      Task[]

  @@unique([workspaceId, email], map: "consultants_workspace_email_key")
  @@unique([workspaceId, document], map: "consultants_workspace_document_key")
  @@index([workspaceId], map: "consultants_workspace_idx")
  @@index([workspaceId, status], map: "consultants_workspace_status_idx")
  @@index([workspaceId, role], map: "consultants_workspace_role_idx")
  @@map("consultants")
}

model Consortium {
  id                       String           @id @default(cuid())
  workspaceId              String           @map("workspace_id")
  name                     String
  administrator            String
  type                     ConsortiumType
  groupNumber              String           @map("group_number")
  minCreditValue           Decimal          @map("min_credit_value") @db.Decimal(18, 2)
  maxCreditValue           Decimal          @map("max_credit_value") @db.Decimal(18, 2)
  defaultTermMonths        Int              @map("default_term_months")
  administrationFeePercent Decimal          @map("administration_fee_percent") @db.Decimal(8, 4)
  reserveFundPercent       Decimal          @map("reserve_fund_percent") @db.Decimal(8, 4)
  totalQuotas              Int              @map("total_quotas")
  availableQuotas          Int              @map("available_quotas")
  status                   ConsortiumStatus @default(FORMING)
  description              String?
  createdAt                DateTime         @default(now()) @map("created_at")
  updatedAt                DateTime         @updatedAt @map("updated_at")
  workspace                Workspace        @relation(fields: [workspaceId], references: [id])
  proposals                Proposal[]
  sales                    Sale[]

  @@unique([workspaceId, administrator, groupNumber], map: "consortiums_workspace_administrator_group_key")
  @@index([workspaceId], map: "consortiums_workspace_idx")
  @@index([workspaceId, status], map: "consortiums_workspace_status_idx")
  @@index([workspaceId, type], map: "consortiums_workspace_type_idx")
  @@index([workspaceId, administrator], map: "consortiums_workspace_administrator_idx")
  @@map("consortiums")
}

model PipelineStage {
  id             String            @id @default(cuid())
  workspaceId    String            @map("workspace_id")
  name           String
  order          Int
  type           PipelineStageType
  color          String
  description    String?
  winProbability Decimal           @map("win_probability") @db.Decimal(5, 2)
  isClosedStage  Boolean           @default(false) @map("is_closed_stage")
  isWonStage     Boolean           @default(false) @map("is_won_stage")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  leads          Lead[]
  workspace      Workspace         @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, type, order], map: "pipeline_stages_workspace_type_order_key")
  @@index([workspaceId], map: "pipeline_stages_workspace_idx")
  @@index([workspaceId, type], map: "pipeline_stages_workspace_type_idx")
  @@index([workspaceId, isClosedStage], map: "pipeline_stages_workspace_closed_idx")
  @@index([workspaceId, isWonStage], map: "pipeline_stages_workspace_won_idx")
  @@map("pipeline_stages")
}

model Lead {
  id                 String              @id @default(cuid())
  workspaceId        String              @map("workspace_id")
  name               String
  email              String
  phone              String
  document           String?
  companyName        String?             @map("company_name")
  source             LeadSource
  status             LeadStatus          @default(NEW)
  consortiumType     ConsortiumType      @map("consortium_type")
  desiredCreditValue Decimal             @map("desired_credit_value") @db.Decimal(18, 2)
  desiredTermMonths  Int                 @map("desired_term_months")
  consultantId       String              @map("consultant_id")
  pipelineStageId    String              @map("pipeline_stage_id")
  score              Int                 @default(0)
  lostReason         String?             @map("lost_reason")
  notes              String?
  convertedClientId  String?             @unique(map: "leads_converted_client_key") @map("converted_client_id")
  lastContactAt      DateTime?           @map("last_contact_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  commercialJourneys CommercialJourney[]
  consultant         Consultant          @relation(fields: [consultantId], references: [id])
  convertedClient    Client?             @relation("LeadConversion", fields: [convertedClientId], references: [id])
  pipelineStage      PipelineStage       @relation(fields: [pipelineStageId], references: [id])
  workspace          Workspace           @relation(fields: [workspaceId], references: [id])
  meetings           Meeting[]
  proposals          Proposal[]
  tasks              Task[]

  @@index([workspaceId], map: "leads_workspace_idx")
  @@index([workspaceId, status], map: "leads_workspace_status_idx")
  @@index([workspaceId, source], map: "leads_workspace_source_idx")
  @@index([workspaceId, consultantId], map: "leads_workspace_consultant_idx")
  @@index([workspaceId, pipelineStageId], map: "leads_workspace_pipeline_stage_idx")
  @@index([workspaceId, consortiumType], map: "leads_workspace_consortium_type_idx")
  @@index([workspaceId, createdAt], map: "leads_workspace_created_at_idx")
  @@map("leads")
}

model Client {
  id                  String              @id @default(cuid())
  workspaceId         String              @map("workspace_id")
  type                PersonType
  name                String
  email               String
  phone               String
  document            String
  birthDate           DateTime?           @map("birth_date") @db.Date
  companyName         String?             @map("company_name")
  tradeName           String?             @map("trade_name")
  stateRegistration   String?             @map("state_registration")
  addressStreet       String              @map("address_street")
  addressNumber       String              @map("address_number")
  addressComplement   String?             @map("address_complement")
  addressNeighborhood String              @map("address_neighborhood")
  addressCity         String              @map("address_city")
  addressState        String              @map("address_state")
  addressZipCode      String              @map("address_zip_code")
  consultantId        String              @map("consultant_id")
  status              ClientStatus        @default(ACTIVE)
  tags                String[]            @default([])
  notes               String?
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  consultant          Consultant          @relation(fields: [consultantId], references: [id])
  workspace           Workspace           @relation(fields: [workspaceId], references: [id])
  commercialJourneys  CommercialJourney[]
  convertedFromLead   Lead?               @relation("LeadConversion")
  meetings            Meeting[]
  proposals           Proposal[]
  sales               Sale[]
  tasks               Task[]

  @@unique([workspaceId, document], map: "clients_workspace_document_key")
  @@index([workspaceId], map: "clients_workspace_idx")
  @@index([workspaceId, status], map: "clients_workspace_status_idx")
  @@index([workspaceId, type], map: "clients_workspace_type_idx")
  @@index([workspaceId, consultantId], map: "clients_workspace_consultant_idx")
  @@index([workspaceId, name], map: "clients_workspace_name_idx")
  @@index([workspaceId, email], map: "clients_workspace_email_idx")
  @@index([workspaceId, createdAt], map: "clients_workspace_created_at_idx")
  @@map("clients")
}

model Proposal {
  id                       String         @id @default(cuid())
  workspaceId              String         @map("workspace_id")
  code                     String
  clientId                 String?        @map("client_id")
  leadId                   String?        @map("lead_id")
  consultantId             String         @map("consultant_id")
  consortiumId             String         @map("consortium_id")
  creditValue              Decimal        @map("credit_value") @db.Decimal(18, 2)
  installmentValue         Decimal        @map("installment_value") @db.Decimal(18, 2)
  termMonths               Int            @map("term_months")
  administrationFeePercent Decimal        @map("administration_fee_percent") @db.Decimal(8, 4)
  reserveFundPercent       Decimal        @map("reserve_fund_percent") @db.Decimal(8, 4)
  status                   ProposalStatus @default(DRAFT)
  sentAt                   DateTime?      @map("sent_at")
  validUntil               DateTime       @map("valid_until")
  acceptedAt               DateTime?      @map("accepted_at")
  rejectedAt               DateTime?      @map("rejected_at")
  rejectionReason          String?        @map("rejection_reason")
  notes                    String?
  createdAt                DateTime       @default(now()) @map("created_at")
  updatedAt                DateTime       @updatedAt @map("updated_at")
  meetings                 Meeting[]
  client                   Client?        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  consortium               Consortium     @relation(fields: [consortiumId], references: [id])
  consultant               Consultant     @relation(fields: [consultantId], references: [id])
  lead                     Lead?          @relation(fields: [leadId], references: [id], onDelete: Restrict)
  workspace                Workspace      @relation(fields: [workspaceId], references: [id])
  sale                     Sale?
  tasks                    Task[]

  @@unique([workspaceId, code], map: "proposals_workspace_code_key")
  @@index([workspaceId], map: "proposals_workspace_idx")
  @@index([workspaceId, status], map: "proposals_workspace_status_idx")
  @@index([workspaceId, consultantId], map: "proposals_workspace_consultant_idx")
  @@index([workspaceId, consortiumId], map: "proposals_workspace_consortium_idx")
  @@index([workspaceId, leadId], map: "proposals_workspace_lead_idx")
  @@index([workspaceId, clientId], map: "proposals_workspace_client_idx")
  @@index([workspaceId, validUntil], map: "proposals_workspace_valid_until_idx")
  @@index([workspaceId, createdAt], map: "proposals_workspace_created_at_idx")
  @@map("proposals")
}

model Meeting {
  id           String          @id @default(cuid())
  workspaceId  String          @map("workspace_id")
  title        String
  description  String?
  type         MeetingType
  status       MeetingStatus   @default(SCHEDULED)
  startAt      DateTime        @map("start_at")
  endAt        DateTime        @map("end_at")
  location     String?
  meetingUrl   String?         @map("meeting_url")
  consultantId String          @map("consultant_id")
  leadId       String?         @map("lead_id")
  clientId     String?         @map("client_id")
  proposalId   String?         @map("proposal_id")
  outcome      MeetingOutcome?
  notes        String?
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  client       Client?         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  consultant   Consultant      @relation(fields: [consultantId], references: [id])
  lead         Lead?           @relation(fields: [leadId], references: [id], onDelete: Restrict)
  proposal     Proposal?       @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id])
  tasks        Task[]

  @@index([workspaceId], map: "meetings_workspace_idx")
  @@index([workspaceId, status], map: "meetings_workspace_status_idx")
  @@index([workspaceId, type], map: "meetings_workspace_type_idx")
  @@index([workspaceId, consultantId], map: "meetings_workspace_consultant_idx")
  @@index([workspaceId, leadId], map: "meetings_workspace_lead_idx")
  @@index([workspaceId, clientId], map: "meetings_workspace_client_idx")
  @@index([workspaceId, proposalId], map: "meetings_workspace_proposal_idx")
  @@index([workspaceId, startAt], map: "meetings_workspace_start_at_idx")
  @@index([workspaceId, consultantId, startAt], map: "meetings_consultant_start_at_idx")
  @@map("meetings")
}

model Sale {
  id                       String        @id @default(cuid())
  workspaceId              String        @map("workspace_id")
  contractNumber           String        @map("contract_number")
  proposalId               String        @unique(map: "sales_proposal_key") @map("proposal_id")
  clientId                 String        @map("client_id")
  consultantId             String        @map("consultant_id")
  consortiumId             String        @map("consortium_id")
  groupNumber              String        @map("group_number")
  quotaNumber              Int           @map("quota_number")
  creditValue              Decimal       @map("credit_value") @db.Decimal(18, 2)
  installmentValue         Decimal       @map("installment_value") @db.Decimal(18, 2)
  termMonths               Int           @map("term_months")
  administrationFeePercent Decimal       @map("administration_fee_percent") @db.Decimal(8, 4)
  reserveFundPercent       Decimal       @map("reserve_fund_percent") @db.Decimal(8, 4)
  commissionValue          Decimal       @map("commission_value") @db.Decimal(18, 2)
  commissionPercent        Decimal       @map("commission_percent") @db.Decimal(8, 4)
  status                   SaleStatus    @default(PENDING_SIGNATURE)
  quotaStatus              QuotaStatus   @default(NOT_CONTEMPLATED) @map("quota_status")
  paymentMethod            PaymentMethod @map("payment_method")
  saleDate                 DateTime      @map("sale_date")
  firstInstallmentDate     DateTime      @map("first_installment_date") @db.Date
  contemplatedAt           DateTime?     @map("contemplated_at")
  paidOffAt                DateTime?     @map("paid_off_at")
  cancelledAt              DateTime?     @map("cancelled_at")
  cancellationReason       String?       @map("cancellation_reason")
  notes                    String?
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")
  client                   Client        @relation(fields: [clientId], references: [id])
  consortium               Consortium    @relation(fields: [consortiumId], references: [id])
  consultant               Consultant    @relation(fields: [consultantId], references: [id])
  proposal                 Proposal      @relation(fields: [proposalId], references: [id])
  workspace                Workspace     @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, contractNumber], map: "sales_workspace_contract_number_key")
  @@unique([workspaceId, consortiumId, groupNumber, quotaNumber], map: "sales_workspace_group_quota_key")
  @@index([workspaceId], map: "sales_workspace_idx")
  @@index([workspaceId, status], map: "sales_workspace_status_idx")
  @@index([workspaceId, quotaStatus], map: "sales_workspace_quota_status_idx")
  @@index([workspaceId, consultantId], map: "sales_workspace_consultant_idx")
  @@index([workspaceId, clientId], map: "sales_workspace_client_idx")
  @@index([workspaceId, consortiumId], map: "sales_workspace_consortium_idx")
  @@index([workspaceId, paymentMethod], map: "sales_workspace_payment_method_idx")
  @@index([workspaceId, saleDate], map: "sales_workspace_sale_date_idx")
  @@index([workspaceId, firstInstallmentDate], map: "sales_workspace_first_installment_idx")
  @@map("sales")
}

model Task {
  id           String       @id @default(cuid())
  workspaceId  String       @map("workspace_id")
  title        String
  description  String?
  type         TaskType
  status       TaskStatus   @default(PENDING)
  priority     TaskPriority @default(MEDIUM)
  dueAt        DateTime     @map("due_at")
  assignedToId String       @map("assigned_to_id")
  leadId       String?      @map("lead_id")
  clientId     String?      @map("client_id")
  meetingId    String?      @map("meeting_id")
  proposalId   String?      @map("proposal_id")
  completedAt  DateTime?    @map("completed_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  assignedTo   Consultant   @relation(fields: [assignedToId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Restrict)
  meeting      Meeting?     @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  proposal     Proposal?    @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId], map: "tasks_workspace_idx")
  @@index([workspaceId, status], map: "tasks_workspace_status_idx")
  @@index([workspaceId, priority], map: "tasks_workspace_priority_idx")
  @@index([workspaceId, type], map: "tasks_workspace_type_idx")
  @@index([workspaceId, assignedToId], map: "tasks_workspace_assigned_to_idx")
  @@index([workspaceId, assignedToId, status], map: "tasks_assigned_to_status_idx")
  @@index([workspaceId, dueAt], map: "tasks_workspace_due_at_idx")
  @@index([workspaceId, status, dueAt], map: "tasks_status_due_at_idx")
  @@index([workspaceId, leadId], map: "tasks_workspace_lead_idx")
  @@index([workspaceId, clientId], map: "tasks_workspace_client_idx")
  @@index([workspaceId, meetingId], map: "tasks_workspace_meeting_idx")
  @@index([workspaceId, proposalId], map: "tasks_workspace_proposal_idx")
  @@map("tasks")
}

model JourneyPhase {
  id                 String              @id @default(cuid())
  workspaceId        String              @map("workspace_id")
  code               String
  name               String
  description        String?
  order              Int
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  commercialJourneys CommercialJourney[]
  workspace          Workspace           @relation(fields: [workspaceId], references: [id])
  states             JourneyState[]

  @@unique([workspaceId, code], map: "journey_phases_workspace_code_key")
  @@unique([workspaceId, order], map: "journey_phases_workspace_order_key")
  @@index([workspaceId], map: "journey_phases_workspace_idx")
  @@index([workspaceId, isActive], map: "journey_phases_workspace_active_idx")
  @@map("journey_phases")
}

model JourneyState {
  id                  String              @id @default(cuid())
  workspaceId         String              @map("workspace_id")
  phaseId             String              @map("phase_id")
  code                String
  name                String
  description         String?
  order               Int
  color               String?
  icon                String?
  isInitial           Boolean             @default(false) @map("is_initial")
  isFinal             Boolean             @default(false) @map("is_final")
  isWon               Boolean             @default(false) @map("is_won")
  isLost              Boolean             @default(false) @map("is_lost")
  allowReopen         Boolean             @default(false) @map("allow_reopen")
  isActive            Boolean             @default(true) @map("is_active")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  commercialJourneys  CommercialJourney[]
  phase               JourneyPhase        @relation(fields: [phaseId], references: [id])
  workspace           Workspace           @relation(fields: [workspaceId], references: [id])
  sourceWorkflowRules WorkflowRule[]      @relation("WorkflowRuleSourceState")
  targetWorkflowRules WorkflowRule[]      @relation("WorkflowRuleTargetState")

  @@unique([workspaceId, code], map: "journey_states_workspace_code_key")
  @@unique([phaseId, order], map: "journey_states_phase_order_key")
  @@index([workspaceId], map: "journey_states_workspace_idx")
  @@index([workspaceId, phaseId], map: "journey_states_workspace_phase_idx")
  @@index([workspaceId, isActive], map: "journey_states_workspace_active_idx")
  @@index([workspaceId, isInitial], map: "journey_states_workspace_initial_idx")
  @@index([workspaceId, isFinal], map: "journey_states_workspace_final_idx")
  @@map("journey_states")
}

model CommercialJourney {
  id                String                    @id @default(cuid())
  workspaceId       String                    @map("workspace_id")
  leadId            String                    @map("lead_id")
  clientId          String?                   @map("client_id")
  consultantId      String                    @map("consultant_id")
  title             String
  consortiumType    ConsortiumType            @map("consortium_type")
  currentPhaseId    String                    @map("current_phase_id")
  currentStateId    String                    @map("current_state_id")
  priority          CommercialJourneyPriority @default(NORMAL)
  score             Int                       @default(0)
  outcome           CommercialJourneyOutcome?
  stateEnteredAt    DateTime                  @map("state_entered_at")
  lastInteractionAt DateTime?                 @map("last_interaction_at")
  closedAt          DateTime?                 @map("closed_at")
  version           Int                       @default(1)
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  commercialActions CommercialAction[]
  commercialEvents  CommercialEvent[]
  client            Client?                   @relation(fields: [clientId], references: [id])
  consultant        Consultant                @relation(fields: [consultantId], references: [id])
  currentPhase      JourneyPhase              @relation(fields: [currentPhaseId], references: [id])
  currentState      JourneyState              @relation(fields: [currentStateId], references: [id])
  lead              Lead                      @relation(fields: [leadId], references: [id])
  workspace         Workspace                 @relation(fields: [workspaceId], references: [id])
  nextBestActions   NextBestAction[]

  @@index([workspaceId], map: "commercial_journeys_workspace_idx")
  @@index([workspaceId, leadId], map: "commercial_journeys_workspace_lead_idx")
  @@index([workspaceId, clientId], map: "commercial_journeys_workspace_client_idx")
  @@index([workspaceId, consultantId], map: "commercial_journeys_workspace_consultant_idx")
  @@index([workspaceId, currentPhaseId], map: "commercial_journeys_workspace_phase_idx")
  @@index([workspaceId, currentStateId], map: "commercial_journeys_workspace_state_idx")
  @@index([workspaceId, priority], map: "commercial_journeys_workspace_priority_idx")
  @@index([workspaceId, outcome], map: "commercial_journeys_workspace_outcome_idx")
  @@index([workspaceId, lastInteractionAt], map: "commercial_journeys_workspace_last_interaction_idx")
  @@index([workspaceId, closedAt], map: "commercial_journeys_workspace_closed_at_idx")
  @@map("commercial_journeys")
}

model CommercialEvent {
  id          String              @id @default(cuid())
  workspaceId String              @map("workspace_id")
  journeyId   String              @map("journey_id")
  type        CommercialEventType
  actorType   CommercialActorType @map("actor_type")
  actorId     String?             @map("actor_id")
  payload     Json                @default("{}")
  occurredAt  DateTime            @map("occurred_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  journey     CommercialJourney   @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  workspace   Workspace           @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId], map: "commercial_events_workspace_idx")
  @@index([workspaceId, journeyId], map: "commercial_events_workspace_journey_idx")
  @@index([workspaceId, type], map: "commercial_events_workspace_type_idx")
  @@index([workspaceId, actorType], map: "commercial_events_workspace_actor_type_idx")
  @@index([workspaceId, occurredAt], map: "commercial_events_workspace_occurred_at_idx")
  @@map("commercial_events")
}

model CommercialAction {
  id                     String                 @id @default(cuid())
  workspaceId            String                 @map("workspace_id")
  journeyId              String                 @map("journey_id")
  type                   CommercialActionType
  status                 CommercialActionStatus @default(PENDING)
  origin                 CommercialActionOrigin
  actorType              CommercialActorType    @map("actor_type")
  actorId                String?                @map("actor_id")
  title                  String
  description            String?
  payload                Json                   @default("{}")
  scheduledFor           DateTime?              @map("scheduled_for")
  startedAt              DateTime?              @map("started_at")
  completedAt            DateTime?              @map("completed_at")
  failedAt               DateTime?              @map("failed_at")
  failureReason          String?                @map("failure_reason")
  createdBy              String?                @map("created_by")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  journey                CommercialJourney      @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  workspace              Workspace              @relation(fields: [workspaceId], references: [id])
  executedNextBestAction NextBestAction?

  @@index([workspaceId], map: "commercial_actions_workspace_idx")
  @@index([workspaceId, journeyId], map: "commercial_actions_workspace_journey_idx")
  @@index([workspaceId, status], map: "commercial_actions_workspace_status_idx")
  @@index([workspaceId, type], map: "commercial_actions_workspace_type_idx")
  @@index([workspaceId, origin], map: "commercial_actions_workspace_origin_idx")
  @@index([workspaceId, scheduledFor], map: "commercial_actions_workspace_scheduled_for_idx")
  @@map("commercial_actions")
}

model WorkflowRule {
  id                       String        @id @default(cuid())
  workspaceId              String?       @map("workspace_id")
  name                     String
  description              String?
  eventType                String        @map("event_type")
  sourceStateId            String?       @map("source_state_id")
  targetStateId            String?       @map("target_state_id")
  conditions               Json          @default("[]")
  actions                  Json          @default("[]")
  priority                 Int           @default(0)
  stopProcessingAfterMatch Boolean       @default(false) @map("stop_processing_after_match")
  isActive                 Boolean       @default(true) @map("is_active")
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")
  sourceState              JourneyState? @relation("WorkflowRuleSourceState", fields: [sourceStateId], references: [id])
  targetState              JourneyState? @relation("WorkflowRuleTargetState", fields: [targetStateId], references: [id])
  workspace                Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId], map: "workflow_rules_workspace_idx")
  @@index([workspaceId, eventType], map: "workflow_rules_workspace_event_type_idx")
  @@index([workspaceId, isActive], map: "workflow_rules_workspace_active_idx")
  @@index([workspaceId, priority], map: "workflow_rules_workspace_priority_idx")
  @@index([sourceStateId], map: "workflow_rules_source_state_idx")
  @@index([targetStateId], map: "workflow_rules_target_state_idx")
  @@map("workflow_rules")
}

model NextBestAction {
  id               String                 @id @default(cuid())
  workspaceId      String                 @map("workspace_id")
  journeyId        String                 @map("journey_id")
  actionType       CommercialActionType   @map("action_type")
  title            String
  description      String?
  reason           String
  confidence       Decimal                @db.Decimal(5, 4)
  priority         NextBestActionPriority @default(NORMAL)
  source           NextBestActionSource
  expiresAt        DateTime?              @map("expires_at")
  acceptedAt       DateTime?              @map("accepted_at")
  rejectedAt       DateTime?              @map("rejected_at")
  executedActionId String?                @unique(map: "next_best_actions_executed_action_key") @map("executed_action_id")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  executedAction   CommercialAction?      @relation(fields: [executedActionId], references: [id])
  journey          CommercialJourney      @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  workspace        Workspace              @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId], map: "next_best_actions_workspace_idx")
  @@index([workspaceId, journeyId], map: "next_best_actions_workspace_journey_idx")
  @@index([workspaceId, priority], map: "next_best_actions_workspace_priority_idx")
  @@index([workspaceId, source], map: "next_best_actions_workspace_source_idx")
  @@index([workspaceId, actionType], map: "next_best_actions_workspace_action_type_idx")
  @@index([workspaceId, expiresAt], map: "next_best_actions_workspace_expires_at_idx")
  @@index([workspaceId, acceptedAt], map: "next_best_actions_workspace_accepted_at_idx")
  @@index([workspaceId, rejectedAt], map: "next_best_actions_workspace_rejected_at_idx")
  @@map("next_best_actions")
}

