# GorillaOS — exemplo seguro de configuração
# Copie para .env.local no desenvolvimento. Nunca versionar valores reais.

# REQUIRED_PRODUCTION — PostgreSQL externo com TLS conforme o provedor.
DATABASE_URL=

# REQUIRED_PRODUCTION — segredo forte e URL HTTPS pública do Better Auth.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# REQUIRED_PRODUCTION — credenciais OAuth do Google autorizadas para o domínio.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# REQUIRED_PRODUCTION — URL HTTPS pública usada por metadata e links do app.
NEXT_PUBLIC_APP_URL=

# REQUIRED_PRODUCTION — workspace atendido por esta instância do piloto.
WORKSPACE_SLUG=consorcio-os

# STAGING_BOOTSTRAP - uso pontual; não é variável do runtime web.
STAGING_BOOTSTRAP_CONFIRM=
STAGING_CONSULTANT_EMAIL=

# LOCAL_ONLY — use development localmente; a plataforma define production no deploy.
NODE_ENV=development

# FUTURE_INTEGRATION — reservadas para o gate externo do R2, fora do runtime principal.
R2_APP_URL=
R2_CDP_PORT=
R2_GATE_DIR=
