# GorillaOS — exemplo de variáveis de ambiente
# Copie para .env e preencha localmente. Nunca commite valores reais.
# Gerado automaticamente em quarta-feira, 5 de agosto de 2026 às 10:59:25 BRT.

# Segredo criptográfico da autenticação.
BETTER_AUTH_SECRET=

# URL base pública usada pelo sistema de autenticação.
BETTER_AUTH_URL=

# String de conexão principal com o banco de dados.
DATABASE_URL=

# Identificador OAuth do Google.
GOOGLE_CLIENT_ID=

# Segredo OAuth do Google.
GOOGLE_CLIENT_SECRET=

# Variável de configuração usada pelo projeto; validar o uso no código citado no HANDOFF.md.
MAX_POSTPONE_MINUTES=

# Variável de configuração usada pelo projeto; validar o uso no código citado no HANDOFF.md.
MIN_POSTPONE_MINUTES=

# URL de serviço externo ou URL base da aplicação.
NEXT_PUBLIC_APP_URL=

# Ambiente de execução do Node.js.
NODE_ENV=

# Variável de configuração usada pelo projeto; validar o uso no código citado no HANDOFF.md.
NOW=

# Variável de configuração usada pelo projeto; validar o uso no código citado no HANDOFF.md.
P=

# URL de serviço externo ou URL base da aplicação.
R2_APP_URL=

# Porta de execução do serviço.
R2_CDP_PORT=

# Variável de configuração usada pelo projeto; validar o uso no código citado no HANDOFF.md.
R2_GATE_DIR=

# Variável de configuração usada pelo projeto; validar o uso no código citado no HANDOFF.md.
WORKSPACE_SLUG=

