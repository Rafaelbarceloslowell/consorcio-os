    "expiration": "expiresAt at or before evaluation time is discarded",
    "queue": "bounded priority queue discards an equal-or-lower-priority incoming item when full",
    "workspace": "event and resolved context must match the orchestrator workspace",
    "user": "when both identifiers exist, event and resolved context userId must match",
